# Pakai SQLite untuk jalan cepat tanpa install Postgres:
DATABASE_URL=sqlite+aiosqlite:///./campusflow.db
# Untuk PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/campusflow

JWT_SECRET=ganti-dengan-string-acak-panjang
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7

# Kosongkan kalau belum punya key -> backend otomatis pakai planner heuristik lokal
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Model vision buat Snap & Go (foto pengumuman tugas -> task)
GROQ_VISION_MODEL=qwen/qwen3.8-27b
# Model speech-to-text buat input suara
GROQ_WHISPER_MODEL=whisper-large-v3
